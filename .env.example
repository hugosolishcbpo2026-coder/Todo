NODE_ENV=development
API_PORT=4000
ADMIN_PORT=3000
# Base URL the admin dashboard uses to reach the API (must be public/NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Base URL the rider/driver Expo apps use; on a physical device use the dev machine's LAN IP
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
# Local SQLite database file (durable, no server). Default: ./data/todo.db
SQLITE_PATH=./data/todo.db
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-me
# OTP: "mock" accepts code 000000 (no provider); "live" generates + sends a real code via WhatsApp
OTP_PROVIDER=mock
OTP_TTL_MINUTES=5
GOOGLE_MAPS_API_KEY=
# Stripe billing. Leave STRIPE_SECRET_KEY blank to run subscriptions in mock mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs for the tiered plans (create them in the Stripe dashboard)
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_BUSINESS=
# Redirect URLs for Checkout + Billing Portal
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/billing
# Optional: override the Stripe API host (used for local testing only)
STRIPE_API_BASE=
# WhatsApp Business Cloud API. Leave blank to run in mock mode (logs instead of sending).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_BASE=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_LANG=en_US
# Optional approved template name for OTP delivery; falls back to a text message
WHATSAPP_OTP_TEMPLATE=
GOOGLE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_DOCUMENTS_FOLDER_ID=
GOOGLE_DRIVE_BACKUPS_FOLDER_ID=
GOOGLE_DRIVE_EXPORTS_FOLDER_ID=
GOOGLE_STORAGE_MODE=manual
